{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign products_to_display = 0
  if section.settings.collection != blank
    assign products_to_display = section.settings.collection.products.size
    if products_to_display > section.settings.products_to_show
      assign products_to_display = section.settings.products_to_show
    endif
  endif

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign columns_tablet_int = section.settings.columns_tablet | plus: 0
  assign columns_desktop_int = section.settings.desktop_columns | plus: 0

  assign grid_desktop_class = 'grid--' | append: columns_desktop_int | append: '-col-desktop'
  assign grid_tablet_class = 'grid--' | append: columns_tablet_int | append: '-col-tablet'
  assign grid_mobile_class = 'grid--' | append: columns_mobile_int | append: '-col-tablet-down'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="CustomFeatured-{{ section.id }}"
  class="custom-featured-collection section-{{ section.id }}-padding"
  style="
    --border-color: {{ section.settings.border_color }};
    --btn-background: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text }};
    --price-color: {{ section.settings.price_color }};
    --title-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --border-radius: {{ section.settings.card_radius }}px;
    --heading-color: {{ section.settings.heading_color }};
    --desktop-columns: {{ columns_desktop_int }};
    --tablet-columns: {{ columns_tablet_int }};
    --mobile-columns: {{ columns_mobile_int }};
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-transform: {{ section.settings.heading_transform }};
    --text-alignment: {{ section.settings.heading_alignment }};
    --bg-color: {{ section.settings.bg_color }};
  "
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="custom-featured-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {%- if section.settings.collection != blank and products_to_display > 0 -%}
      <slider-component class="custom-featured-slider slider-mobile-gutter slider-component-desktop">
        <ul
          id="Slider-{{ section.id }}"
          class="custom-featured-grid grid product-grid slider slider--desktop slider--tablet grid--peek contains-card contains-card--product {{ grid_desktop_class }} {{ grid_tablet_class }} {{ grid_mobile_class }}"
          role="list"
          aria-label="{{ section.settings.heading | default: 'Products' | escape }}"
        >
          {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
            {% assign quick_view_form_id = 'quick-add-' | append: section.id | append: product.id %}

            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="grid__item slider__slide"
            >
              <div class="custom-product-card">          <a href="{{ product.url }}" class="custom-wishlist">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 21s-6.716-4.35-9.428-8.428C-1.227 6.856 3.108 1 8.286 4.286L12 8l3.714-3.714C20.892 1 25.227 6.856 21.428 12.572 18.716 16.65 12 21 12 21z"/>
            </svg>
          </a>

          <div class="custom-product-image">

            {% if product.featured_image != blank %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.title }}"
                loading="lazy"
                width="400"
                height="500"
              >
            {% endif %}

            <div class="custom-hover-buttons">

              <div class="quick-add no-js-hidden custom-quick-add">
                <modal-opener data-modal="#QuickAdd-{{ product.id }}">
                  <button
                    id="{{ quick_view_form_id }}-submit"
                    type="button"
                    class="custom-hover-btn"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ quick_view_form_id }}-submit custom-title-{{ section.id }}-{{ product.id }}"
                    data-product-url="{{ product.url }}"
                  >
                    QUICK VIEW
                    {%- render 'loading-spinner' -%}
                  </button>
                </modal-opener>
                <quick-add-modal id="QuickAdd-{{ product.id }}" class="quick-add-modal">
                  <div
                    role="dialog"
                    aria-label="{{ 'products.product.choose_product_options' | t: product_name: product.title | escape }}"
                    aria-modal="true"
                    class="quick-add-modal__content global-settings-popup"
                    tabindex="-1"
                  >
                    <button
                      id="ModalClose-{{ product.id }}"
                      type="button"
                      class="quick-add-modal__toggle"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {{- 'icon-close.svg' | inline_asset_content -}}
                    </button>
                    <div id="QuickAddInfo-{{ product.id }}" class="quick-add-modal__content-info"></div>
                  </div>
                </quick-add-modal>
              </div>

              {% if product.available %}
                <product-form>
                  {% form 'product', product %}
                    <input
                      type="hidden"
                      name="id"
                      value="{{ product.selected_or_first_available_variant.id }}"
                    >

                    <button type="submit" class="custom-hover-btn">
                      ADD TO CART
                    </button>
                  {% endform %}
                </product-form>
              {% endif %}

            </div>

          </div>

          <div class="custom-product-info">
            <h3 class="custom-product-title">
              <a id="custom-title-{{ section.id }}-{{ product.id }}" href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>
            <div class="custom-price">
              {% render 'price', product: product %}
            </div>
          </div>

              </div>
            </li>
          {% endfor %}
        </ul>

        {%- if products_to_display > 1 -%}
          <div class="slider-buttons custom-featured-slider-buttons">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
              <span class="slider-counter--total">{{ products_to_display }}</span>
            </div>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        {%- endif -%}
      </slider-component>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Custom FeaturedCollection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Desktop columns (visible per slide)"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "Tablet columns (visible per slide)"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns (visible per slide)",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading transform",
      "options": [
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 52,
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 20,
      "label": "Card radius"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Padding bottom"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Collection"
    }
  ]
}
{% endschema %}