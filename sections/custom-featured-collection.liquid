{{ 'component-price.css' | asset_url | stylesheet_tag }}

<section class="custom-featured-collection"
  style="
    --border-color: {{ section.settings.border_color }};
    --btn-background: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text }};
    --price-color: {{ section.settings.price_color }};
    --title-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --border-radius: {{ section.settings.card_radius }}px;
    --heading-color: {{ section.settings.heading_color }};
    --desktop-columns: {{ section.settings.desktop_columns }};
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-transform: {{ section.settings.heading_transform }};
    --text-alignment: {{ section.settings.heading_alignment }};
    --bg-color: {{ section.settings.bg_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="custom-featured-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="custom-featured-grid">

      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}

        <div class="custom-product-card">

          <a href="{{ product.url }}" class="custom-wishlist">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 21s-6.716-4.35-9.428-8.428C-1.227 6.856 3.108 1 8.286 4.286L12 8l3.714-3.714C20.892 1 25.227 6.856 21.428 12.572 18.716 16.65 12 21 12 21z"/>
            </svg>
          </a>

          <div class="custom-product-image">

            {% if product.featured_image != blank %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.title }}"
                loading="lazy"
                width="400"
                height="500"
              >
            {% endif %}

            <div class="custom-hover-buttons">

              <modal-opener data-modal="#QuickViewModal-{{ product.id }}">
                <button
                  type="button"
                  class="custom-hover-btn"
                  aria-haspopup="dialog"
                >
                  QUICK VIEW
                </button>
              </modal-opener>

              {% if product.available %}
                <product-form>
                  {% form 'product', product %}
                    <input
                      type="hidden"
                      name="id"
                      value="{{ product.selected_or_first_available_variant.id }}"
                    >

                    <button type="submit" class="custom-hover-btn">
                      ADD TO CART
                    </button>
                  {% endform %}
                </product-form>
              {% endif %}

            </div>

          </div>

          <modal-dialog id="QuickViewModal-{{ product.id }}" class="custom-quick-view-modal media-modal">
            <div
              role="dialog"
              aria-modal="true"
              class="custom-quick-view-modal__content"
              tabindex="-1"
            >
              <button
                id="ModalClose-{{ product.id }}"
                type="button"
                class="custom-quick-view-modal__close"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                {{- 'icon-close.svg' | inline_asset_content -}}
              </button>

              <div class="custom-quick-view-modal__body">
                <div class="custom-quick-view-modal__image">
                  {% if product.featured_image != blank %}
                    <img
                      src="{{ product.featured_image | image_url: width: 1000 }}"
                      alt="{{ product.title }}"
                      loading="lazy"
                      width="600"
                      height="700"
                    >
                  {% endif %}
                </div>

                <div class="custom-quick-view-modal__info">
                  <h2 class="custom-quick-view-modal__title">{{ product.title }}</h2>

                  <div class="custom-price">
                    {% render 'price', product: product %}
                  </div>

                  {% if product.vendor != blank %}
                    <p class="custom-quick-view-modal__vendor">{{ product.vendor }}</p>
                  {% endif %}

                  {% if product.description != blank %}
                    <div class="custom-quick-view-modal__description">
                      {{ product.description | strip_html | truncate: 400 }}
                    </div>
                  {% endif %}

                  {% if product.options_with_values != blank %}
                    <div class="custom-quick-view-modal__options">
                      {% for option in product.options_with_values %}
                        <div class="custom-quick-view-modal__option">
                          <span class="custom-quick-view-modal__option-label">{{ option.name }}:</span>
                          <span class="custom-quick-view-modal__option-value">{{ option.values | first }}</span>
                        </div>
                      {% endfor %}
                    </div>
                  {% endif %}

                  {% if product.available %}
                    <product-form>
                      {% form 'product', product %}
                        <input
                          type="hidden"
                          name="id"
                          value="{{ product.selected_or_first_available_variant.id }}"
                        >
                        <button type="submit" class="button custom-quick-view-modal__add-to-cart">
                          ADD TO CART
                        </button>
                      {% endform %}
                    </product-form>
                  {% else %}
                    <button type="button" class="button button--disabled custom-quick-view-modal__sold-out" disabled>
                      {{ 'products.product.sold_out' | t }}
                    </button>
                  {% endif %}

                  <a href="{{ product.url }}" class="link custom-quick-view-modal__view-details">
                    {{ 'products.product.view_full_details' | t }}
                  </a>
                </div>
              </div>
            </div>
          </modal-dialog>

          <div class="custom-product-info">
            <h3 class="custom-product-title">
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>

            <div class="custom-price">
              {% render 'price', product: product %}
            </div>
          </div>

        </div>

      {% endfor %}

    </div>
  </div>
</section>

<style>
  .custom-quick-view-modal {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    z-index: -1;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .custom-quick-view-modal[open] {
    opacity: 1;
    visibility: visible;
    z-index: 101;
  }

  .custom-quick-view-modal .custom-quick-view-modal__content {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
    min-height: 100vh;
  }

  .custom-quick-view-modal__body {
    width: min(1200px, 100%);
    background: rgb(var(--color-background));
    border-radius: 2rem;
    box-shadow: 0 3rem 6rem rgba(0, 0, 0, 0.18);
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(320px, 1fr);
    gap: 2rem;
    padding: 2rem;
    max-width: 1200px;
  }

  .custom-quick-view-modal__image img {
    width: 100%;
    height: auto;
    border-radius: 1.5rem;
    object-fit: cover;
    display: block;
  }

  .custom-quick-view-modal__close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    background: transparent;
    border: none;
    color: rgb(var(--color-foreground));
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .custom-quick-view-modal__title {
    margin: 0 0 1rem;
    font-size: 2rem;
    line-height: 1.1;
  }

  .custom-quick-view-modal__vendor,
  .custom-quick-view-modal__description,
  .custom-quick-view-modal__options,
  .custom-quick-view-modal__view-details {
    margin-top: 1rem;
  }

  .custom-quick-view-modal__vendor {
    font-size: 0.95rem;
    color: rgba(var(--color-foreground), 0.75);
  }

  .custom-quick-view-modal__description {
    color: rgba(var(--color-foreground), 0.88);
    line-height: 1.75;
  }

  .custom-quick-view-modal__options {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .custom-quick-view-modal__option {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.95rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 1rem;
    background: rgba(var(--color-foreground), 0.03);
  }

  .custom-quick-view-modal__add-to-cart {
    width: 100%;
    margin-top: 1.5rem;
  }

  .custom-quick-view-modal__view-details {
    display: inline-block;
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .custom-quick-view-modal__body {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .custom-quick-view-modal__close {
      top: 0.75rem;
      right: 0.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "Custom FeaturedCollection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading transform",
      "options": [
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 52,
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 20,
      "label": "Card radius"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Padding bottom"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Collection"
    }
  ]
}
{% endschema %}