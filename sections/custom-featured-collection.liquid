{{ 'component-price.css' | asset_url | stylesheet_tag }}

<section class="custom-featured-collection"
  style="
    --border-color: {{ section.settings.border_color }};
    --btn-background: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text }};
    --price-color: {{ section.settings.price_color }};
    --title-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --border-radius: {{ section.settings.card_radius }}px;
    --heading-color: {{ section.settings.heading_color }};
    --desktop-columns: {{ section.settings.desktop_columns }};
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-transform: {{ section.settings.heading_transform }};
    --text-alignment: {{ section.settings.heading_alignment }};
    --bg-color: {{ section.settings.bg_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="custom-featured-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="custom-featured-grid">

      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}

        <div class="custom-product-card">

          <a href="{{ product.url }}" class="custom-wishlist">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 21s-6.716-4.35-9.428-8.428C-1.227 6.856 3.108 1 8.286 4.286L12 8l3.714-3.714C20.892 1 25.227 6.856 21.428 12.572 18.716 16.65 12 21 12 21z"/>
            </svg>
          </a>

          <div class="custom-product-image">

            {% if product.featured_image != blank %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.title }}"
                loading="lazy"
                width="400"
                height="500"
              >
            {% endif %}

            <div class="custom-hover-buttons">

              <modal-opener data-modal="#QuickViewModal-{{ product.id }}">
                <button
                  type="button"
                  class="custom-hover-btn"
                  aria-haspopup="dialog"
                >
                  QUICK VIEW
                </button>
              </modal-opener>

              {% if product.available %}
                <product-form>
                  {% form 'product', product %}
                    <input
                      type="hidden"
                      name="id"
                      value="{{ product.selected_or_first_available_variant.id }}"
                    >

                    <button type="submit" class="custom-hover-btn">
                      ADD TO CART
                    </button>
                  {% endform %}
                </product-form>
              {% endif %}

            </div>

          </div>

          <modal-dialog id="QuickViewModal-{{ product.id }}" class="custom-quick-view-modal media-modal">
            <div
              role="dialog"
              aria-modal="true"
              class="custom-quick-view-modal__content"
              tabindex="-1"
            >
              <button
                id="ModalClose-{{ product.id }}"
                type="button"
                class="custom-quick-view-modal__close"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                {{- 'icon-close.svg' | inline_asset_content -}}
              </button>

              <div class="custom-quick-view-modal__body">
                <div class="custom-quick-view-modal__image">
                  {% if product.featured_image != blank %}
                    <img
                      src="{{ product.featured_image | image_url: width: 1000 }}"
                      alt="{{ product.title }}"
                      loading="lazy"
                      width="600"
                      height="700"
                    >
                  {% endif %}
                </div>

                <div class="custom-quick-view-modal__info">
                  <h2 class="custom-quick-view-modal__title">{{ product.title }}</h2>

                  <div class="custom-quick-view-modal__price-row">
                    <div class="custom-price">
                      {% render 'price', product: product %}
                    </div>
                    {% if product.compare_at_price > product.price %}
                      <span class="custom-quick-view-modal__sale-badge">Sale</span>
                    {% endif %}
                  </div>

                  <p class="custom-quick-view-modal__meta">
                    Tax included. Shipping calculated at checkout.
                  </p>

                  <p class="custom-quick-view-modal__stock">
                    <span class="custom-quick-view-modal__stock-dot"></span>
                    {% if product.selected_or_first_available_variant.inventory_quantity != blank %}
                      {{ product.selected_or_first_available_variant.inventory_quantity }} in stock
                    {% elsif product.available %}
                      In stock
                    {% else %}
                      Out of stock
                    {% endif %}
                  </p>

                  {% if product.description != blank %}
                    <div class="custom-quick-view-modal__description">
                      {{ product.description | strip_html | truncate: 420 }}
                    </div>
                  {% endif %}

                  {% if product.options_with_values != blank %}
                    {% assign selected_options = product.selected_or_first_available_variant.selected_options %}
                    <div class="custom-quick-view-modal__variants" data-product-id="{{ product.id }}">
                      <input type="hidden" class="variant-id-input" value="{{ product.selected_or_first_available_variant.id }}">
                      {% for option in product.options_with_values %}
                        {% capture selected_value %}{% for selected in selected_options %}{% if selected.name == option.name %}{{ selected.value }}{% endif %}{% endfor %}{% endcapture %}
                        <div class="custom-quick-view-modal__variant-group">
                          <div class="custom-quick-view-modal__variant-label">{{ option.name }}:</div>
                          <div class="custom-quick-view-modal__variant-values" data-option-name="{{ option.name }}">
                            {% for value in option.values %}
                              {% capture option_value %}{{ value }}{% endcapture %}
                              {% if option.name contains 'Color' or option.name contains 'Colour' %}
                                <button 
                                  type="button" 
                                  class="custom-quick-view-modal__swatch-button{% if option_value == selected_value %} selected{% endif %}" 
                                  data-option-value="{{ value }}"
                                  data-option-name="{{ option.name }}"
                                  style="--swatch-color: var(--color-{{ value | downcase | replace: ' ', '-' }}, #ccc);" 
                                  title="{{ value }}"
                                >
                                  <span class="swatch" style="background-color: var(--swatch-color);"></span>
                                </button>
                              {% else %}
                                <button 
                                  type="button" 
                                  class="custom-quick-view-modal__pill{% if option_value == selected_value %} selected{% endif %}"
                                  data-option-value="{{ value }}"
                                  data-option-name="{{ option.name }}"
                                >
                                  {{ value }}
                                </button>
                              {% endif %}
                            {% endfor %}
                          </div>
                        </div>
                      {% endfor %}
                      
                      <script type="application/json" class="product-variants-data">
                        {{ product.variants | json }}
                      </script>
                    </div>
                  {% endif %}

                  {% if product.available %}
                    <product-form>
                      {% form 'product', product %}
                        <input
                          type="hidden"
                          name="id"
                          value="{{ product.selected_or_first_available_variant.id }}"
                        >
                        <button type="submit" class="button custom-quick-view-modal__add-to-cart">
                          ADD TO CART
                        </button>
                      {% endform %}
                    </product-form>
                  {% else %}
                    <button type="button" class="button button--disabled custom-quick-view-modal__sold-out" disabled>
                      {{ 'products.product.sold_out' | t }}
                    </button>
                  {% endif %}

                  <a href="{{ product.url }}" class="link custom-quick-view-modal__view-details">
                    {{ 'products.product.view_full_details' | t }}
                  </a>
                </div>
              </div>
            </div>
          </modal-dialog>

          <div class="custom-product-info">
            <h3 class="custom-product-title">
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>

            <div class="custom-price">
              {% render 'price', product: product %}
            </div>
          </div>

        </div>

      {% endfor %}

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Handle variant selection in quick view modal
    const variantButtons = document.querySelectorAll(
      '.custom-quick-view-modal__swatch-button, .custom-quick-view-modal__pill'
    );

    variantButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        
        const variantContainer = this.closest('.custom-quick-view-modal__variants');
        if (!variantContainer) return;

        // Update selected state for this option group
        const buttonGroup = this.closest('.custom-quick-view-modal__variant-values');
        buttonGroup.querySelectorAll('button').forEach(btn => {
          btn.classList.remove('selected');
        });
        this.classList.add('selected');

        // Build selected options object
        const optionElements = variantContainer.querySelectorAll('.custom-quick-view-modal__variant-group');
        const selectedOptions = [];
        
        optionElements.forEach(group => {
          const selectedBtn = group.querySelector('button.selected');
          if (selectedBtn) {
            selectedOptions.push(selectedBtn.dataset.optionValue);
          }
        });

        // Find matching variant
        const variantsData = JSON.parse(
          variantContainer.querySelector('.product-variants-data').textContent
        );
        
        // Match variant by comparing all options
        const matchingVariant = variantsData.find(variant => {
          return selectedOptions.every((selectedValue, idx) => {
            return variant.options[idx] === selectedValue;
          });
        });

        if (matchingVariant && matchingVariant.available) {
          // Update all variant inputs within the modal
          const modal = variantContainer.closest('.custom-quick-view-modal');
          const variantInputs = modal.querySelectorAll('input[name="id"]');
          variantInputs.forEach(input => {
            input.value = matchingVariant.id;
          });
        }
      });
    });

    // Set initial selected states from product data
    document.querySelectorAll('.custom-quick-view-modal__variants').forEach(variantContainer => {
      const variantsData = JSON.parse(
        variantContainer.querySelector('.product-variants-data').textContent
      );
      const firstAvailable = variantsData.find(v => v.available);
      
      if (firstAvailable) {
        firstAvailable.options.forEach((optionValue, idx) => {
          const optionGroup = variantContainer.querySelectorAll('.custom-quick-view-modal__variant-group')[idx];
          if (optionGroup) {
            optionGroup.querySelectorAll('button').forEach(btn => {
              btn.classList.remove('selected');
              if (btn.dataset.optionValue === optionValue) {
                btn.classList.add('selected');
              }
            });
          }
        });
      }
    });
  });
</script>

<style>
  /* Color definitions for swatches */
  :root {
    --color-red: #ff0000;
    --color-blue: #0000ff;
    --color-green: #00aa00;
    --color-black: #000000;
    --color-white: #ffffff;
    --color-gray: #808080;
    --color-pink: #ffb6c1;
    --color-yellow: #ffff00;
    --color-orange: #ff8c00;
    --color-purple: #800080;
    --color-brown: #a52a2a;
    --color-navy: #000080;
    --color-beige: #f5f5dc;
    --color-khaki: #f0e68c;
    --color-olive: #808000;
  }

  .custom-quick-view-modal {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    z-index: -1;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .custom-quick-view-modal[open] {
    opacity: 1;
    visibility: visible;
    z-index: 101;
  }

  .custom-quick-view-modal .custom-quick-view-modal__content {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
    min-height: 100vh;
  }

  .custom-quick-view-modal__body {
    width: min(1200px, 100%);
    background: rgb(var(--color-background));
    border-radius: 2rem;
    box-shadow: 0 3rem 6rem rgba(0, 0, 0, 0.18);
    display: grid;
    grid-template-columns: minmax(360px, 1fr) minmax(340px, 1fr);
    gap: 2rem;
    padding: 2rem;
    max-width: 1200px;
  }

  .custom-quick-view-modal__image {
    display: grid;
    place-items: center;
    border-radius: 1.5rem;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.04);
  }

  .custom-quick-view-modal__image img {
    width: 100%;
    height: auto;
    max-height: 780px;
    object-fit: contain;
    display: block;
  }

  .custom-quick-view-modal__info {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .custom-quick-view-modal__close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    background: transparent;
    border: none;
    color: rgb(var(--color-foreground));
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .custom-quick-view-modal__title {
    margin: 0;
    font-size: clamp(2rem, 2.5vw, 2.6rem);
    line-height: 1.05;
  }

  .custom-quick-view-modal__price-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .custom-quick-view-modal__sale-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .custom-quick-view-modal__meta {
    margin: 0;
    color: rgba(var(--color-foreground), 0.72);
    line-height: 1.75;
    font-size: 0.95rem;
  }

  .custom-quick-view-modal__stock {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-weight: 600;
    color: rgb(var(--color-foreground));
  }

  .custom-quick-view-modal__stock-dot {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: #39b54a;
    display: inline-block;
  }

  .custom-quick-view-modal__description {
    color: rgba(var(--color-foreground), 0.88);
    line-height: 1.75;
    margin: 0;
  }

  .custom-quick-view-modal__variants {
    display: grid;
    gap: 1.25rem;
  }

  .custom-quick-view-modal__variant-group {
    display: grid;
    gap: 0.75rem;
  }

  .custom-quick-view-modal__variant-label {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(var(--color-foreground), 0.8);
  }

  .custom-quick-view-modal__variant-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .custom-quick-view-modal__pill,
  .custom-quick-view-modal__swatch-button {
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 0;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 0.95rem;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .custom-quick-view-modal__pill {
    padding: 0.8rem 1rem;
    min-width: 3.2rem;
    white-space: nowrap;
  }

  .custom-quick-view-modal__pill.selected {
    border-color: rgb(var(--color-foreground));
    background: rgba(var(--color-foreground), 0.06);
  }

  .custom-quick-view-modal__swatch-button {
    width: 3.25rem;
    height: 3.25rem;
    padding: 0.4rem;
    display: grid;
    place-items: center;
  }

  .custom-quick-view-modal__swatch-button.selected {
    border-color: rgb(var(--color-foreground));
    box-shadow: 0 0 0 0.2rem rgba(var(--color-foreground), 0.12);
  }

  .custom-quick-view-modal__swatch-button .swatch {
    width: 100%;
    height: 100%;
  }

  .custom-quick-view-modal__add-to-cart {
    width: 100%;
    margin-top: 1.5rem;
  }

  .custom-quick-view-modal__view-details {
    display: inline-flex;
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .custom-quick-view-modal__body {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .custom-quick-view-modal__image {
      order: 2;
    }

    .custom-quick-view-modal__info {
      order: 1;
    }

    .custom-quick-view-modal__close {
      top: 0.75rem;
      right: 0.75rem;
    }
    
    .custom-quick-view-modal__body {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .custom-quick-view-modal__close {
      top: 0.75rem;
      right: 0.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "Custom FeaturedCollection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading transform",
      "options": [
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 52,
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 20,
      "label": "Card radius"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Padding bottom"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Collection"
    }
  ]
}
{% endschema %}