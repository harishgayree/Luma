
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  .custom-featured-collection {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }

  .custom-featured-collection .page-width {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .custom-featured-heading {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 50px;
  }

  .custom-featured-heading h2 {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    text-transform: {{ section.settings.heading_transform }};
    font-weight: 600;
    letter-spacing: 1px;
  }

  .custom-featured-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    border: 1px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
  }

  .custom-product-card {
    position: relative;
    background: {{ section.settings.card_bg }};
    border-right: 1px solid {{ section.settings.border_color }};
    transition: all .3s ease;
  }

  .custom-product-card:last-child {
    border-right: 0;
  }

  .custom-product-image {
    position: relative;
    overflow: hidden;
    padding: 20px;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-product-image img {
    width: 100%;
    max-width: 100%;
    max-height: 320px;
    object-fit: contain;
    transition: transform .5s ease;
  }

  .custom-product-card:hover .custom-product-image img {
    transform: scale(1.05);
  }

  .custom-product-info {
    border-top: 1px solid {{ section.settings.border_color }};
    padding: 20px;
    text-align: center;
  }

  .custom-product-title {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
  }

  .custom-product-title a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }

  .custom-price {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .custom-price .price-item--regular {
    font-size: 18px;
    font-weight: 700;
    color: {{ section.settings.price_color }};
  }

  .custom-price s {
    color: #777;
  }

  /* Hover Buttons */

  .custom-hover-buttons {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%) translateY(20px);
    display: flex;
    gap: 12px;
    opacity: 0;
    visibility: hidden;
    transition: all .35s ease;
    z-index: 5;
  }

  .custom-product-card:hover .custom-hover-buttons {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .custom-hover-btn {
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text }};
    border: 0;
    padding: 14px 24px;
    border-radius: 40px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: .3s ease;
  }

  .custom-hover-btn:hover {
    opacity: .85;
  }

  /* Wishlist */

  .custom-wishlist {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: .35s ease;
    z-index: 6;
    box-shadow: 0 2px 10px rgba(0,0,0,.08);
  }

  .custom-product-card:hover .custom-wishlist {
    opacity: 1;
    visibility: visible;
  }

  .custom-wishlist svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 989px) {
    .custom-featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .custom-hover-buttons {
      flex-direction: column;
      width: calc(100% - 40px);
      gap: 10px;
      bottom: 15px;
    }

    .custom-hover-btn,
    .custom-hover-buttons form {
      width: 100%;
    }

    .custom-hover-btn {
      width: 100%;
      padding: 12px 16px;
      font-size: 13px;
      text-align: center;
    }
    }

    .custom-product-card:nth-child(2n) {
      border-right: 0;
    }

    .custom-product-image {
      min-height: 350px;
    }
  }

  @media screen and (max-width: 749px) {
    .custom-featured-grid {
      grid-template-columns: 1fr;
    }

    .custom-product-image img {
      max-height: 260px;
    }
    }

    .custom-product-card {
      border-right: 0;
      border-bottom: 1px solid {{ section.settings.border_color }};
    }

    .custom-product-image {
      min-height: 300px;
      padding: 30px;
    }

    .custom-hover-buttons {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%);
      bottom: 20px;
    }

    .custom-featured-heading h2 {
      font-size: 32px;
    }
  }
</style>

<section class="custom-featured-collection">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="custom-featured-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="custom-featured-grid">

      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}

        <div class="custom-product-card">

          <a href="{{ product.url }}" class="custom-wishlist">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 21s-6.716-4.35-9.428-8.428C-1.227 6.856 3.108 1 8.286 4.286L12 8l3.714-3.714C20.892 1 25.227 6.856 21.428 12.572 18.716 16.65 12 21 12 21z"/>
            </svg>
          </a>

          <div class="custom-product-image">

            {% if product.featured_image != blank %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.title }}"
                loading="lazy"
                width="400"
                height="500"
              >
            {% endif %}

            <div class="custom-hover-buttons">

              <a href="{{ product.url }}" class="custom-hover-btn">
                QUICK VIEW
              </a>

              {% if product.available %}
                <product-form>
                  {% form 'product', product %}
                    <input
                      type="hidden"
                      name="id"
                      value="{{ product.selected_or_first_available_variant.id }}"
                    >

                    <button type="submit" class="custom-hover-btn">
                      ADD TO CART
                    </button>
                  {% endform %}
                </product-form>
              {% endif %}

            </div>

          </div>

          <div class="custom-product-info">
            <h3 class="custom-product-title">
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>

            <div class="custom-price">
              {% render 'price', product: product %}
            </div>
          </div>

        </div>

      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom FeaturedCollection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Desktop columns"
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "default": 1600,
      "label": "Page width"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading transform",
      "options": [
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 52,
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 20,
      "label": "Card radius"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Padding bottom"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Collection"
    }
  ]
}
{% endschema %}