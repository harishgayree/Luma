{{ 'component-price.css' | asset_url | stylesheet_tag }}

<section class="custom-featured-collection"
  style="
    --border-color: {{ section.settings.border_color }};
    --btn-background: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text }};
    --price-color: {{ section.settings.price_color }};
    --title-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --border-radius: {{ section.settings.card_radius }}px;
    --heading-color: {{ section.settings.heading_color }};
    --desktop-columns: {{ section.settings.desktop_columns }};
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-transform: {{ section.settings.heading_transform }};
    --text-alignment: {{ section.settings.heading_alignment }};
    --bg-color: {{ section.settings.bg_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="custom-featured-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="custom-featured-grid">

      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}

        <div class="custom-product-card">

          <a href="{{ product.url }}" class="custom-wishlist">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 21s-6.716-4.35-9.428-8.428C-1.227 6.856 3.108 1 8.286 4.286L12 8l3.714-3.714C20.892 1 25.227 6.856 21.428 12.572 18.716 16.65 12 21 12 21z"/>
            </svg>
          </a>

          <div class="custom-product-image">

            {% if product.featured_image != blank %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.title }}"
                loading="lazy"
                width="400"
                height="500"
              >
            {% endif %}

            <div class="custom-hover-buttons">

              <a href="{{ product.url }}" class="custom-hover-btn">
                QUICK VIEW
              </a>

              {% if product.available %}
                <product-form>
                  {% form 'product', product %}
                    <input
                      type="hidden"
                      name="id"
                      value="{{ product.selected_or_first_available_variant.id }}"
                    >

                    <button type="submit" class="custom-hover-btn">
                      ADD TO CART
                    </button>
                  {% endform %}
                </product-form>
              {% endif %}

            </div>

          </div>

          <div class="custom-product-info">
            <h3 class="custom-product-title">
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>

            <div class="custom-price">
              {% render 'price', product: product %}
            </div>
          </div>

        </div>

      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom FeaturedCollection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading transform",
      "options": [
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 52,
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 20,
      "label": "Card radius"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "label": "Padding bottom"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Collection"
    }
  ]
}
{% endschema %}