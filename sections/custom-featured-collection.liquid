{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section class="custom-featured-collection"
  style="
    --border-color: {{ section.settings.border_color }};
    --btn-background: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text }};
    --price-color: {{ section.settings.price_color }};
    --title-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --border-radius: {{ section.settings.card_radius }}px;
    --heading-color: {{ section.settings.heading_color }};
    --desktop-columns: {{ section.settings.desktop_columns }};
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-transform: {{ section.settings.heading_transform }};
    --text-alignment: {{ section.settings.heading_alignment }};
    --bg-color: {{ section.settings.bg_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="custom-featured-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% assign product_count = 0 %}
    {% if section.settings.collection != blank %}
      {% assign product_count = section.settings.collection.products.size %}
    {% endif %}
    {% assign show_mobile_slider = product_count > 1 %}

    <slider-component class="slider-mobile-gutter{% unless show_mobile_slider %} page-width{% endunless %}">
      <ul
        id="Slider-{{ section.id }}"
        class="custom-featured-grid grid grid--{{ section.settings.desktop_columns }}-col-desktop grid--2-col-tablet-down{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      >
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}

        <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="grid__item{% if show_mobile_slider %} slider__slide{% endif %}">
          {% render 'card-product',
            card_product: product,
            media_aspect_ratio: 'adapt',
            image_shape: 'rectangle',
            lazy_load: false,
            show_secondary_image: true,
            show_vendor: false,
            show_rating: false,
            skip_styles: false,
            section_id: section.id,
            quick_add: 'standard'
          %}
        </li>

      {% endfor %}
      </ul>
                              {% else %}
                                <button 
                                  type="button" 
                                  class="custom-quick-view-modal__pill{% if option_value == selected_value %} selected{% endif %}"
                                  data-option-value="{{ value }}"
                                  data-option-name="{{ option.name }}"
                                >
                                  {{ value }}
                                </button>
                              {% endif %}
                            {% endfor %}
                          </div>
                        </div>
                      {% endfor %}
                      
                      <script type="application/json" class="product-variants-data">
                        {{ product.variants | json }}
                      </script>
                    </div>
                  {% endif %}

                  {% if product.available %}
                    <product-form>
                      {% form 'product', product %}
                        <input
                          type="hidden"
                          name="id"
                          value="{{ product.selected_or_first_available_variant.id }}"
                        >
                        <button type="submit" class="button custom-quick-view-modal__add-to-cart">
                          ADD TO CART
                        </button>
                      {% endform %}
                    </product-form>
                  {% else %}
                    <button type="button" class="button button--disabled custom-quick-view-modal__sold-out" disabled>
                      {{ 'products.product.sold_out' | t }}
                    </button>
                  {% endif %}

                  <a href="{{ product.url }}" class="link custom-quick-view-modal__view-details">
                    {{ 'products.product.view_full_details' | t }}
                  </a>
                </div>
              </div>
            </div>
          </modal-dialog>

          <div class="custom-product-info">
            <h3 class="custom-product-title">
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>

            <div class="custom-price">
              {% render 'price', product: product %}
            </div>
          </div>

        </div>

      {% endfor %}
      </div>

      {% if show_mobile_slider %}
        <div class="slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ product_count }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {% endif %}
    </slider-component>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Handle variant selection in quick view modal
    const variantButtons = document.querySelectorAll(
      '.custom-quick-view-modal__swatch-button, .custom-quick-view-modal__pill'
    );

    variantButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        
        const variantContainer = this.closest('.custom-quick-view-modal__variants');
        if (!variantContainer) return;

        // Update selected state for this option group
        const buttonGroup = this.closest('.custom-quick-view-modal__variant-values');
        buttonGroup.querySelectorAll('button').forEach(btn => {
          btn.classList.remove('selected');
        });
        this.classList.add('selected');

        // Build selected options object
        const optionElements = variantContainer.querySelectorAll('.custom-quick-view-modal__variant-group');
        const selectedOptions = [];
        
        optionElements.forEach(group => {
          const selectedBtn = group.querySelector('button.selected');
          if (selectedBtn) {
            selectedOptions.push(selectedBtn.dataset.optionValue);
          }
        });

        // Find matching variant
        const variantsData = JSON.parse(
          variantContainer.querySelector('.product-variants-data').textContent
        );
        
        // Match variant by comparing all options
        const matchingVariant = variantsData.find(variant => {
          return selectedOptions.every((selectedValue, idx) => {
            return variant.options[idx] === selectedValue;
          });
        });

        if (matchingVariant && matchingVariant.available) {
          // Update all variant inputs within the modal
          const modal = variantContainer.closest('.custom-quick-view-modal');
          const variantInputs = modal.querySelectorAll('input[name="id"]');
          variantInputs.forEach(input => {
            input.value = matchingVariant.id;
          });
        }
      });
    });

    // Set initial selected states from product data
    document.querySelectorAll('.custom-quick-view-modal__variants').forEach(variantContainer => {
      const variantsData = JSON.parse(
        variantContainer.querySelector('.product-variants-data').textContent
      );
      const firstAvailable = variantsData.find(v => v.available);
      
      if (firstAvailable) {
        firstAvailable.options.forEach((optionValue, idx) => {
          const optionGroup = variantContainer.querySelectorAll('.custom-quick-view-modal__variant-group')[idx];
          if (optionGroup) {
            optionGroup.querySelectorAll('button').forEach(btn => {
              btn.classList.remove('selected');
              if (btn.dataset.optionValue === optionValue) {
                btn.classList.add('selected');
              }
            });
          }
        });
      }
    });

    // Image slider functionality
    document.querySelectorAll('.custom-quick-view-modal__image-container').forEach(container => {
      const images = container.querySelectorAll('.product-image');
      if (images.length <= 1) return;

      const prevBtn = container.querySelector('.custom-quick-view-modal__image-nav--prev');
      const nextBtn = container.querySelector('.custom-quick-view-modal__image-nav--next');
      const modal = container.closest('.custom-quick-view-modal');
      const thumbnails = modal?.querySelector('.custom-quick-view-modal__thumbnails');

      let currentIndex = 0;

      const showImage = (index) => {
        images.forEach((img, idx) => {
          img.classList.toggle('active', idx === index);
        });
        if (thumbnails) {
          thumbnails.querySelectorAll('.custom-quick-view-modal__thumbnail').forEach((thumb, idx) => {
            thumb.classList.toggle('active', idx === index);
          });
        }
        currentIndex = index;
      };

      const nextImage = () => {
        const newIndex = (currentIndex + 1) % images.length;
        showImage(newIndex);
      };

      const prevImage = () => {
        const newIndex = (currentIndex - 1 + images.length) % images.length;
        showImage(newIndex);
      };

      if (prevBtn) prevBtn.addEventListener('click', prevImage);
      if (nextBtn) nextBtn.addEventListener('click', nextImage);

      // Thumbnail click handlers
      if (thumbnails) {
        thumbnails.querySelectorAll('.custom-quick-view-modal__thumbnail').forEach(thumb => {
          thumb.addEventListener('click', () => {
            const index = parseInt(thumb.dataset.imageIndex, 10);
            showImage(index);
          });
        });
      }

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (modal?.hasAttribute('open')) {
          if (e.key === 'ArrowLeft') prevImage();
          if (e.key === 'ArrowRight') nextImage();
        }
      });
    });
  });
</script>

<style>
  /* Color definitions for swatches */
  :root {
    --color-red: #ff0000;
    --color-blue: #0000ff;
    --color-green: #00aa00;
    --color-black: #000000;
    --color-white: #ffffff;
    --color-gray: #808080;
    --color-pink: #ffb6c1;
    --color-yellow: #ffff00;
    --color-orange: #ff8c00;
    --color-purple: #800080;
    --color-brown: #a52a2a;
    --color-navy: #000080;
    --color-beige: #f5f5dc;
    --color-khaki: #f0e68c;
    --color-olive: #808000;
  }

  .custom-featured-collection {
    background: var(--bg-color);
    padding: calc(var(--padding-top) * 1px) 0 calc(var(--padding-bottom) * 1px);
  }

  .custom-featured-heading {
    margin-bottom: 1.75rem;
    text-align: var(--text-alignment);
  }

  .custom-featured-heading h2 {
    margin: 0;
    color: var(--heading-color);
    font-size: clamp(1.8rem, 2.5vw, 3.25rem);
    letter-spacing: 0.02em;
  }

  .custom-featured-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .custom-product-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    background: var(--card-bg);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-product-card:hover {
    transform: translateY(-0.15rem);
    box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.08);
  }

  .custom-product-image {
    position: relative;
    display: block;
  }

  .custom-product-image img {
    width: 100%;
    display: block;
    height: auto;
  }

  .custom-hover-buttons {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    z-index: 2;
    padding: 0.25rem 0.5rem;
    background: rgba(0, 0, 0, 0.35);
    border-radius: 999px;
  }

  .custom-product-card:hover .custom-hover-buttons,
  .custom-product-card:focus-within .custom-hover-buttons {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(-0.15rem);
  }

  .custom-hover-btn {
    border: none;
    background: rgba(0, 0, 0, 0.82);
    color: #fff;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.5rem;
    min-height: 3.5rem;
  }

  .custom-product-info {
    padding: 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .custom-product-title {
    margin: 0;
    font-size: 1rem;
  }

  .custom-product-title a {
    color: var(--title-color);
    text-decoration: none;
  }

  .custom-price {
    color: var(--price-color);
    font-weight: 700;
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .custom-featured-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }

    .custom-hover-buttons {
      position: static;
      transform: none;
      opacity: 1;
      visibility: visible;
      width: 100%;
      margin: 0.75rem 0 0;
      background: transparent;
      justify-content: center;
      padding: 0;
      border-radius: 0;
    }

    .custom-hover-btn {
      min-width: 0;
      flex: 1 1 45%;
      max-width: 45%;
      font-size: 0.8rem;
    }

    .custom-product-card:hover .custom-hover-buttons,
    .custom-product-card:focus-within .custom-hover-buttons {
      transform: none;
    }
  }

  @media (max-width: 600px) {
    .custom-featured-grid {
      grid-template-columns: 1fr;
    }

    .custom-hover-btn {
      flex: 1 1 100%;
      max-width: 100%;
    }

    .custom-product-info {
      padding: 1rem 0.75rem 1.25rem;
    }
  }

  .custom-quick-view-modal {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    z-index: -1;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .custom-quick-view-modal[open] {
    opacity: 1;
    visibility: visible;
    z-index: 101;
  }

  .custom-quick-view-modal .custom-quick-view-modal__content {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
    min-height: 100vh;
  }

  .custom-quick-view-modal__body {
    width: min(1100px, 100%);
    background: rgb(var(--color-background));
    border-radius: 2rem;
    box-shadow: 0 3rem 6rem rgba(0, 0, 0, 0.18);
    display: grid;
    grid-template-columns: minmax(360px, 1fr) minmax(340px, 1fr);
    gap: 2rem;
    padding: 2rem;
    max-width: 1100px;
    position: relative;
  }

  .custom-quick-view-modal__image-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .custom-quick-view-modal__image-container {
    position: relative;
    display: grid;
    place-items: center;
    border-radius: 1.5rem;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.04);
  }

  .custom-quick-view-modal__image {
    position: relative;
    width: 100%;
    display: grid;
    place-items: center;
    border-radius: 1.5rem;
    overflow: hidden;
  }

  .custom-quick-view-modal__image img.product-image {
    width: 100%;
    height: auto;
    max-height: 580px;
    object-fit: contain;
    display: none;
    block-size: auto;
  }

  .custom-quick-view-modal__image img.product-image.active {
    display: block;
  }

  .custom-quick-view-modal__image-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    cursor: pointer;
    z-index: 10;
    transition: background-color 0.2s ease;
  }

  .custom-quick-view-modal__image-nav:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  .custom-quick-view-modal__image-nav svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .custom-quick-view-modal__image-nav--prev {
    left: 0.75rem;
  }

  .custom-quick-view-modal__image-nav--next {
    right: 0.75rem;
  }

  .custom-quick-view-modal__thumbnails {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding: 0.5rem 0;
    scroll-behavior: smooth;
  }

  .custom-quick-view-modal__thumbnails::-webkit-scrollbar {
    height: 0.4rem;
  }

  .custom-quick-view-modal__thumbnails::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-quick-view-modal__thumbnails::-webkit-scrollbar-thumb {
    background: rgba(var(--color-foreground), 0.2);
    border-radius: 0.2rem;
  }

  .custom-quick-view-modal__thumbnail {
    flex-shrink: 0;
    width: 5rem;
    height: 5rem;
    border: 2px solid transparent;
    border-radius: 0.75rem;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s ease, opacity 0.2s ease;
    background: transparent;
    padding: 0;
    opacity: 0.6;
  }

  .custom-quick-view-modal__thumbnail:hover {
    opacity: 0.9;
  }

  .custom-quick-view-modal__thumbnail.active {
    border-color: rgb(var(--color-foreground));
    opacity: 1;
  }

  .custom-quick-view-modal__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .custom-quick-view-modal__info {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .custom-quick-view-modal__close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    background: transparent;
    border: none;
    color: rgb(var(--color-foreground));
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .custom-quick-view-modal__title {
    margin: 0;
    font-size: clamp(2rem, 2.5vw, 2.6rem);
    line-height: 1.05;
  }

  .custom-quick-view-modal__price-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .custom-quick-view-modal__sale-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .custom-quick-view-modal__meta {
    margin: 0;
    color: rgba(var(--color-foreground), 0.72);
    line-height: 1.75;
    font-size: 0.95rem;
  }

  .custom-quick-view-modal__stock {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-weight: 600;
    color: rgb(var(--color-foreground));
  }

  .custom-quick-view-modal__stock-dot {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: #39b54a;
    display: inline-block;
  }

  .custom-quick-view-modal__description {
    color: rgba(var(--color-foreground), 0.88);
    line-height: 1.75;
    margin: 0;
  }

  .custom-quick-view-modal__variants {
    display: grid;
    gap: 1.25rem;
  }

  .custom-quick-view-modal__variant-group {
    display: grid;
    gap: 0.75rem;
  }

  .custom-quick-view-modal__variant-label {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(var(--color-foreground), 0.8);
  }

  .custom-quick-view-modal__variant-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .custom-quick-view-modal__pill,
  .custom-quick-view-modal__swatch-button {
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 0;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 0.95rem;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .custom-quick-view-modal__pill {
    padding: 0.9rem 1rem;
    min-width: 5.2rem;
    white-space: nowrap;
    font-size: 14px;
  }

  .custom-quick-view-modal__pill.selected {
    border-color: rgb(var(--color-foreground));
    {% comment %} background: rgba(var(--color-foreground), 0.06); {% endcomment %}
  }

  .custom-quick-view-modal__swatch-button {
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }

  .custom-quick-view-modal__swatch-button.selected {
    border-color: rgb(var(--color-foreground));
    box-shadow: 0 0 0 0.2rem rgba(var(--color-foreground), 0.12);
  }

  .custom-quick-view-modal__swatch-button .swatch {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .custom-quick-view-modal__add-to-cart {
    width: 100%;
    margin-top: 1.5rem;
  }

  .custom-quick-view-modal__add-to-cart:after, .custom-quick-view-modal__add-to-cart:hover:after {
    box-shadow: none !important;
  }

  .custom-quick-view-modal__view-details {
    display: inline-flex;
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .custom-quick-view-modal__body {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .custom-quick-view-modal__image-section {
      order: 2;
    }

    .custom-quick-view-modal__info {
      order: 1;
    }

    .custom-quick-view-modal__image-nav {
      width: 2rem;
      height: 2rem;
    }

    .custom-quick-view-modal__image-nav svg {
      width: 1rem;
      height: 1rem;
    }

    .custom-quick-view-modal__image-nav--prev {
      left: 0.5rem;
    }

    .custom-quick-view-modal__image-nav--next {
      right: 0.5rem;
    }

    .custom-quick-view-modal__thumbnail {
      width: 4rem;
      height: 4rem;
    }

    .custom-quick-view-modal__close {
      top: 0.75rem;
      right: 0.75rem;
    }

    .custom-quick-view-modal__body {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .custom-quick-view-modal__close {
      top: 0.75rem;
      right: 0.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "Custom FeaturedCollection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
