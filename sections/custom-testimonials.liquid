<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<section class="testimonial-sec-{{ section.id }}">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="testimonial-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="swiper testimonial-slider-{{ section.id }}">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
          <div class="swiper-slide">

            <div class="testimonial-card">

              <div class="testimonial-stars">
                {% for i in (1..block.settings.rating) %}
                  ★
                {% endfor %}
              </div>

              <div class="testimonial-text">
                {{ block.settings.review }}
              </div>

              {% if block.settings.image != blank %}
                <div class="testimonial-image">
                  {{
                    block.settings.image
                    | image_url: width: 200
                    | image_tag
                  }}
                </div>
              {% endif %}

              <h3 class="testimonial-name">
                {{ block.settings.name }}
              </h3>

              <div class="testimonial-role">
                {{ block.settings.role }}
              </div>

            </div>

          </div>
        {% endfor %}

      </div>

      <div class="swiper-pagination"></div>

    </div>

  </div>
</section>

<style>
.testimonial-sec-{{ section.id }}{
  padding: 36px 20px;
  background: {{ section.settings.bg_color }};
}

.testimonial-heading{
  text-align:center;
  margin-bottom:25px;
  font-size:40px;
  color:{{ section.settings.heading_color }};
  font-weight: bold;
}

.testimonial-card{
  background: {{ section.settings.card_bg }};
  padding:30px;
  border-radius:16px;
  text-align:center;
  height:100%;
}

.testimonial-stars{
  color:#ffb400;
  font-size:22px;
  margin-bottom:20px;
}

.testimonial-text{
  font-size:18px;
  line-height:1.7;
  margin-bottom:25px;
  color:{{ section.settings.text_color }};
}

.testimonial-image{
  width:90px;
  height:90px;
  border-radius:100%;
  overflow:hidden;
  margin:0 auto 20px;
}

.testimonial-image img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.testimonial-name{
  margin:0;
  font-size:24px;
}

.testimonial-role{
  margin-top:8px;
  color:#666;
}

.swiper-pagination{
  position:relative;
  margin-top:30px;
}

@media(max-width:767px){

  .testimonial-heading{
    font-size:28px;
  }

  .testimonial-card{
    padding:22px;
  }

  .testimonial-text{
    font-size:15px;
  }

}
</style>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" async></script>

<script>
document.addEventListener('DOMContentLoaded', function(){

  new Swiper('.testimonial-slider-{{ section.id }}', {
    loop: true,
    spaceBetween: 20,

    pagination: {
      el: '.testimonial-sec-{{ section.id }} .swiper-pagination',
      clickable: true,
    },

    autoplay: {
      delay: 3000,
    },

    breakpoints: {
      0: {
        slidesPerView: 1
      },
      768: {
        slidesPerView: 2
      },
      1024: {
        slidesPerView: 3
      }
    }
  });

});
</script>

{% schema %}
{
  "name": "Custom Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TESTIMONIALS"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ebebeb"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#555555"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Manager"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "Lorem ipsum dolor sit amet."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Testimonials"
    }
  ]
}
{% endschema %}