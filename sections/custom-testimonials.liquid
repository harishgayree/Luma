
{%- style -%}
.testimonial-section-{{ section.id }}{
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
}

.testimonial-wrapper-{{ section.id }}{
  max-width: {{ section.settings.page_width }}px;
  margin: 0 auto;
}

.testimonial-heading-{{ section.id }}{
  text-align: center;
  margin-bottom: 50px;
}

.testimonial-heading-{{ section.id }} h2{
  margin: 0;
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight: {{ section.settings.heading_weight }};
  text-transform: {{ section.settings.heading_transform }};
  line-height: 1.2;
}

.testimonial-slider-{{ section.id }}{
  overflow: hidden;
}

.testimonial-card-{{ section.id }}{
  background: {{ section.settings.card_bg }};
  border-radius: {{ section.settings.card_radius }}px;
  padding: 40px 30px;
  text-align: center;
  height: 100%;
  transition: 0.3s ease;
  border: 1px solid {{ section.settings.card_border }};
}

.testimonial-card-{{ section.id }}:hover{
  transform: translateY(-5px);
}

.testimonial-stars-{{ section.id }}{
  display: flex;
  justify-content: center;
  gap: 4px;
  margin-bottom: 25px;
}

.testimonial-stars-{{ section.id }} svg{
  width: 18px;
  height: 18px;
  fill: {{ section.settings.star_color }};
}

.testimonial-text-{{ section.id }}{
  font-size: {{ section.settings.text_size }}px;
  line-height: 1.7;
  color: {{ section.settings.text_color }};
  margin-bottom: 35px;
}

.testimonial-image-{{ section.id }}{
  width: {{ section.settings.image_size }}px;
  height: {{ section.settings.image_size }}px;
  margin: 0 auto 20px;
  border-radius: 50%;
  overflow: hidden;
}

.testimonial-image-{{ section.id }} img{
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.testimonial-name-{{ section.id }}{
  margin: 0;
  font-size: {{ section.settings.name_size }}px;
  color: {{ section.settings.name_color }};
  font-weight: 700;
}

.testimonial-designation-{{ section.id }}{
  margin-top: 8px;
  font-size: {{ section.settings.designation_size }}px;
  color: {{ section.settings.designation_color }};
}

.testimonial-nav-{{ section.id }}{
  margin-top: 40px;
  display: flex;
  justify-content: center;
  gap: 12px;
}

.testimonial-nav-{{ section.id }} .swiper-button-next,
.testimonial-nav-{{ section.id }} .swiper-button-prev{
  position: unset;
  width: 45px;
  height: 45px;
  background: {{ section.settings.arrow_bg }};
  border-radius: 50%;
  margin: 0;
  color: {{ section.settings.arrow_color }};
  transition: 0.3s ease;
}

.testimonial-nav-{{ section.id }} .swiper-button-next:hover,
.testimonial-nav-{{ section.id }} .swiper-button-prev:hover{
  transform: scale(1.05);
}

.testimonial-nav-{{ section.id }} .swiper-button-next:after,
.testimonial-nav-{{ section.id }} .swiper-button-prev:after{
  font-size: 16px;
  font-weight: 700;
}

.testimonial-pagination-{{ section.id }}{
  margin-top: 25px;
  text-align: center;
}

.testimonial-pagination-{{ section.id }} .swiper-pagination-bullet{
  background: {{ section.settings.dot_color }};
  opacity: 0.5;
}

.testimonial-pagination-{{ section.id }} .swiper-pagination-bullet-active{
  opacity: 1;
  background: {{ section.settings.dot_active_color }};
}

@media screen and (max-width: 1024px){

  .testimonial-card-{{ section.id }}{
    padding: 35px 25px;
  }

  .testimonial-heading-{{ section.id }} h2{
    font-size: calc({{ section.settings.heading_size }}px - 8px);
  }
}

@media screen and (max-width: 767px){

  .testimonial-section-{{ section.id }}{
    padding: 60px 15px;
  }

  .testimonial-heading-{{ section.id }}{
    margin-bottom: 30px;
  }

  .testimonial-heading-{{ section.id }} h2{
    font-size: 30px;
  }

  .testimonial-card-{{ section.id }}{
    padding: 30px 20px;
  }

  .testimonial-text-{{ section.id }}{
    font-size: 15px;
  }

  .testimonial-image-{{ section.id }}{
    width: 80px;
    height: 80px;
  }
}
{%- endstyle -%}

<section class="testimonial-section-{{ section.id }}">
  <div class="testimonial-wrapper-{{ section.id }}">

    {% if section.settings.heading != blank %}
      <div class="testimonial-heading-{{ section.id }}">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="swiper testimonial-slider-{{ section.id }}">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="testimonial-card-{{ section.id }}">

              <div class="testimonial-stars-{{ section.id }}">
                {% assign rating = block.settings.rating %}
                {% for i in (1..rating) %}
                  <svg viewBox="0 0 24 24">
                    <path d="M12 .587l3.668 7.431 8.2 1.193-5.934 5.782 1.4 8.168L12 18.896l-7.334 3.865 1.4-8.168L.132 9.211l8.2-1.193z"/>
                  </svg>
                {% endfor %}
              </div>

              {% if block.settings.review_text != blank %}
                <div class="testimonial-text-{{ section.id }}">
                  {{ block.settings.review_text }}
                </div>
              {% endif %}

              {% if block.settings.image != blank %}
                <div class="testimonial-image-{{ section.id }}">
                  {{
                    block.settings.image
                    | image_url: width: 200
                    | image_tag:
                      loading: 'lazy',
                      alt: block.settings.name
                  }}
                </div>
              {% endif %}

              {% if block.settings.name != blank %}
                <h3 class="testimonial-name-{{ section.id }}">
                  {{ block.settings.name }}
                </h3>
              {% endif %}

              {% if block.settings.designation != blank %}
                <div class="testimonial-designation-{{ section.id }}">
                  {{ block.settings.designation }}
                </div>
              {% endif %}

            </div>
          </div>
        {% endfor %}

      </div>

      {% if section.settings.show_arrows %}
        <div class="testimonial-nav-{{ section.id }}">
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        </div>
      {% endif %}

      {% if section.settings.show_dots %}
        <div class="swiper-pagination testimonial-pagination-{{ section.id }}"></div>
      {% endif %}
    </div>

  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function(){

  new Swiper(".testimonial-slider-{{ section.id }}", {
    loop: true,
    spaceBetween: {{ section.settings.space_between }},
    autoplay: {
      delay: {{ section.settings.autoplay_speed }},
      disableOnInteraction: false,
    },

    navigation: {
      nextEl: ".testimonial-section-{{ section.id }} .swiper-button-next",
      prevEl: ".testimonial-section-{{ section.id }} .swiper-button-prev",
    },

    pagination: {
      el: ".testimonial-section-{{ section.id }} .swiper-pagination",
      clickable: true,
    },

    breakpoints: {
      0: {
        slidesPerView: 1
      },
      768: {
        slidesPerView: 2
      },
      1024: {
        slidesPerView: {{ section.settings.desktop_per_view }}
      }
    }
  });

});
</script>

