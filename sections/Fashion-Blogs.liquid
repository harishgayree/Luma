{{ 'section-fashion-blogs.css' | asset_url | stylesheet_tag }}

<section class="fashion-blogs-section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    
    {% if section.settings.heading != blank %}
      <div class="section-heading">
        <h2>{{ section.settings.heading }}</h2>
        <span class="heading-line"></span>
      </div>
    {% endif %}

    <div class="fashion-blog-grid">

      <!-- LEFT BIG BLOG -->
      <div class="fashion-blog-large">
        {% assign first_block = section.blocks.first %}

        {% if first_block != blank %}
          <div class="blog-card large-card">

            {% if first_block.settings.image != blank %}
              <img
                src="{{ first_block.settings.image | image_url: width: 1200 }}"
                alt="{{ first_block.settings.title }}"
                loading="lazy"
                width=""
                height=""
              >
            {% endif %}

            <div class="blog-overlay"></div>

            <div class="blog-content center-content">
              
              {% if first_block.settings.date != blank %}
                <span class="blog-date">
                  {{ first_block.settings.date }}
                </span>
              {% endif %}

              {% if first_block.settings.title != blank %}
                <h3>{{ first_block.settings.title }}</h3>
              {% endif %}

              {% if first_block.settings.text != blank %}
                <p>{{ first_block.settings.text }}</p>
              {% endif %}

              {% if first_block.settings.button_text != blank %}
                <a href="{{ first_block.settings.button_link }}" class="read-more-btn">
                  {{ first_block.settings.button_text }}
                </a>
              {% endif %}
            </div>

          </div>
        {% endif %}
      </div>

      <!-- RIGHT SMALL BLOGS -->
      <div class="fashion-blog-right">

        {% for block in section.blocks offset: 1 %}
          <div class="small-blog-item" {{ block.shopify_attributes }}>

            <div class="small-blog-image">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 700 }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy"
                  width=""
                  height=""
                >
              {% endif %}
            </div>

            <div class="small-blog-content">

              {% if block.settings.date != blank %}
                <span class="blog-date">
                  {{ block.settings.date }}
                </span>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p>{{ block.settings.text }}</p>
              {% endif %}

              {% if block.settings.button_text != blank %}
                <a href="{{ block.settings.button_link }}" class="read-more-btn">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}

            </div>

          </div>
        {% endfor %}

      </div>

    </div>
  </div>
</section>

<style>
.fashion-blogs-section{
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.bg_color }};
}

.fashion-blogs-section .page-width{
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

.section-heading{
  text-align:center;
  margin-bottom:50px;
}

.section-heading h2{
  margin:0;
  font-size: {{ section.settings.heading_size }}px;
  color: {{ section.settings.heading_color }};
  font-weight:700;
  text-transform: uppercase;
}

.heading-line{
  width:120px;
  height:2px;
  background:#e5dada;
  display:block;
  margin:18px auto 0;
}

.fashion-blog-grid{
  display:grid;
  grid-template-columns: 1.3fr 1fr;
  gap:35px;
  align-items:start;
}

.large-card{
  position:relative;
  overflow:hidden;
  border-radius:16px;
  min-height:700px;
}

.large-card img{
  width:100%;
  height:100%;
  object-fit:cover;
  position:absolute;
  inset:0;
}

.blog-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(to top, rgba(0,0,0,.75), rgba(0,0,0,.1));
}

.center-content{
  position:absolute;
  left:50%;
  bottom:40px;
  transform:translateX(-50%);
  text-align:center;
  width:100%;
  max-width:600px;
  padding:0 20px;
  z-index:2;
}

.blog-date{
  background:#fff;
  color:#000;
  font-size:22px;
  font-weight:600;
  padding:10px 22px;
  border-radius:8px;
  display:inline-block;
  margin-bottom:20px;
  line-height:1;
}

.large-card h3{
  color:#fff;
  margin:0 0 15px;
  font-size:46px;
  line-height:1.2;
}

.large-card p{
  color:#fff;
  font-size:28px;
  line-height:1.6;
  margin:0 auto 25px;
}

.read-more-btn{
  color:inherit;
  font-weight:700;
  text-transform:uppercase;
  text-decoration:underline;
  font-size:20px;
}

.fashion-blog-right{
  display:flex;
  flex-direction:column;
  gap:40px;
}

.small-blog-item{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap:30px;
  align-items:center;
}

.small-blog-image{
  border-radius:16px;
  overflow:hidden;
}

.small-blog-image img{
  width:100%;
  display:block;
  height:320px;
  object-fit:cover;
}

.small-blog-content h3{
  margin:0 0 15px;
  font-size:32px;
  line-height:1.3;
  color: {{ section.settings.text_color }};
}

.small-blog-content p{
  margin:0 0 20px;
  font-size:22px;
  line-height:1.7;
  color: {{ section.settings.text_color }};
}

.small-blog-content .blog-date{
  background:#1d1d1d;
  color:#fff;
  font-size:20px;
  margin-bottom:20px;
}

.small-blog-content .read-more-btn{
  color: {{ section.settings.text_color }};
}

@media screen and (max-width: 1200px){

  .large-card{
    min-height:550px;
  }

  .large-card h3{
    font-size:36px;
  }

  .large-card p{
    font-size:22px;
  }

  .small-blog-content h3{
    font-size:26px;
  }

  .small-blog-content p{
    font-size:18px;
  }
}

@media screen and (max-width: 991px){

  .fashion-blog-grid{
    grid-template-columns:1fr;
  }

  .fashion-blog-right{
    gap:25px;
  }

  .small-blog-item{
    grid-template-columns:1fr;
    gap:20px;
  }

  .small-blog-image img{
    height:280px;
  }

  .center-content{
    bottom:30px;
  }
}

@media screen and (max-width: 767px){

  .fashion-blogs-section{
    padding:60px 0;
  }

  .section-heading{
    margin-bottom:35px;
  }

  .section-heading h2{
    font-size:32px !important;
  }

  .large-card{
    min-height:450px;
  }

  .blog-date{
    font-size:16px;
    padding:8px 18px;
  }

  .large-card h3{
    font-size:28px;
  }

  .large-card p{
    font-size:16px;
    line-height:1.5;
  }

  .small-blog-content h3{
    font-size:22px;
  }

  .small-blog-content p{
    font-size:15px;
  }

  .read-more-btn{
    font-size:15px;
  }

  .small-blog-image img{
    height:220px;
  }
}
</style>

{% schema %}
{
  "name": "Fashion Blogs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FASHION BLOGS"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 54
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "blog",
      "name": "Blog",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "06 Mar"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Why do we use it?"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Lorem ipsum dolor sit amet consectetur adipiscing elit, sed do eiusmod tempor incididunt..."
        },
        {
          "type": "text",
          "id": "button_text", 
          "label": "Button Text",
          "default": "READ MORE"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fashion Blogs",
      "blocks": [
        {
          "type": "blog"
        },
        {
          "type": "blog"
        },
        {
          "type": "blog"
        }
      ]
    }
  ]
}
{% endschema %}