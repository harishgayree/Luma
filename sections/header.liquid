    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    },
    {
      "type": "header",
      "content": "Custom Header Settings"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "url",
      "id": "wishlist_link",
      "label": "Wishlist link"
    },
    {
      "type": "range",
      "id": "custom_logo_width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 180
    },
    {
      "type": "range",
      "id": "search_height",
      "min": 40,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Search height",
      "default": 56
    },
    {
      "type": "range",
      "id": "search_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Search border radius",
      "default": 40
    },
    {
      "type": "color",
      "id": "search_bg",
      "label": "Search background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "search_border",
      "label": "Search border",
      "default": "#dddddd"
    },
    {
      "type": "color",
      "id": "search_button_bg",
      "label": "Search button bg",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "search_button_icon",
      "label": "Search button icon",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "offer_bg",
      "label": "Offer icon bg",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "offer_color",
      "label": "Offer text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "min": 10,
      "max": 30,
