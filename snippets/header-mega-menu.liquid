{% comment %}
  Custom Mega Menu
{% endcomment %}

<nav class="header__inline-menu custom-mega-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li class="custom-mega-item">
        
        {%- assign mega_block = blank -%}

        {% assign link_title = link.title | strip | downcase %}
        {% for block in section.blocks %}
          {% if block.type == 'mega_menu' %}
            {% assign block_title = block.settings.menu_title | strip | downcase %}
            {% if block_title != blank and block_title == link_title %}
              {% assign mega_block = block %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if link.links != blank %}

          {% if mega_block != blank %}

          <div class="custom-mega-wrapper">

            <a
              href="{{ link.url }}"
              class="header__menu-item list-menu__item link"
            >
              {{ link.title }}
            </a>

            <div class="custom-mega-dropdown">

              <div class="page-width custom-mega-inner">

                <!-- LEFT SIDE MENU -->
                <div class="custom-mega-links">

                  {%- for childlink in link.links -%}

                    <div class="mega-column">

                      <a
                        href="{{ childlink.url }}"
                        class="mega-heading"
                      >
                        {{ childlink.title }}
                      </a>

                      {% if childlink.links != blank %}
                        <ul class="mega-submenu">
                          {% for grandchildlink in childlink.links %}
                            <li>
                              <a href="{{ grandchildlink.url }}">
                                {{ grandchildlink.title }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}

                    </div>

                  {%- endfor -%}
                </div>

                <!-- RIGHT SIDE PRODUCT / COLLECTION -->
                {% if mega_block != blank %}
                  <div class="custom-mega-product">

                    <div class="mega-product-heading">
                      {{ mega_block.settings.heading }}
                    </div>

                    <div class="mega-product-grid">

                      {% if mega_block.settings.collection != blank %}

                        {% assign mega_collection = mega_block.settings.collection %}
                        {% if mega_collection.url == blank %}
                          {% if mega_collection.handle != blank %}
                            {% assign mega_collection = collections[mega_collection.handle] %}
                          {% else %}
                            {% assign mega_collection = collections[mega_collection] %}
                          {% endif %}
                        {% endif %}

                        {% if mega_collection != blank %}
                          <div class="mega-product-card mega-collection-card">

                            <a href="{{ mega_collection.url }}">

                              <div class="mega-product-image">

                                {% if mega_collection.featured_image != blank %}

                                  {{
                                    mega_collection.featured_image
                                    | image_url: width: 600
                                    | image_tag
                                  }}

                                {% elsif mega_collection.products.first.featured_image != blank %}

                                  {{
                                    mega_collection.products.first.featured_image
                                    | image_url: width: 600
                                    | image_tag
                                  }}

                                {% endif %}

                              </div>

                              <div class="mega-product-info">

                                <h4>{{ mega_collection.title }}</h4>

                                <p>
                                  {{ mega_collection.products_count }} Products
                                </p>

                              </div>

                            </a>

                          </div>
                        {% endif %}

                      {% elsif mega_block.settings.product_1 != blank or mega_block.settings.product_2 != blank %}

                        {% assign product_handle_1 = mega_block.settings.product_1.handle | default: mega_block.settings.product_1 %}
                        {% assign product_handle_2 = mega_block.settings.product_2.handle | default: mega_block.settings.product_2 %}
                        {% assign products_array = product_handle_1 | append: ',' | append: product_handle_2 | split: ',' %}

                        {% for handle in products_array %}
                          {% assign handle = handle | strip %}
                          {% if handle != blank %}
                            {% assign product = all_products[handle] %}

                            {% if product != blank %}

                              <div class="mega-product-card">

                                <a href="{{ product.url }}">

                                  <div class="mega-product-image">
                                    {{
                                      product.featured_image
                                      | image_url: width: 400
                                      | image_tag
                                    }}
                                  </div>

                                  <div class="mega-product-info">
                                    <h4>{{ product.title }}</h4>

                                    <div class="price">
                                      {{ product.price | money }}
                                    </div>

                                  </div>

                                </a>

                              </div>

                            {% endif %}
                          {% endif %}

                        {% endfor %}

                      {% endif %}

                    </div>

                  </div>
                {% endif %}

              </div>

            </div>

          </div>

          {% else %}

          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
                style="font-size:{{ section.settings.font-size }}px"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <ul
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                {%- for childlink in link.links -%}
                  <li>
                    {%- if childlink.links == blank -%}
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    {%- else -%}
                      <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                        <summary
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                        >
                          <span>{{ childlink.title | escape }}</span>
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </summary>
                        <ul
                          id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__submenu list-menu motion-reduce"
                        >
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                                style="font-size:{{ section.settings.font-size }}px"
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          </header-menu>

          {% endif %}

        {% else %}

          <a
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link"
          >
            {{ link.title }}
          </a>

        {% endif %}
      </li>
    {%- endfor -%}
  </ul>
</nav>