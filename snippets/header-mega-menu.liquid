{% comment %}
  Custom Mega Menu
{% endcomment %}

<nav class="header__inline-menu custom-mega-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li class="custom-mega-item">
        
        {%- assign mega_block = blank -%}

        {% for block in section.blocks %}
          {% if block.settings.menu_title == link.title %}
            {% assign mega_block = block %}
          {% endif %}
        {% endfor %}

        {% if link.links != blank %}

          <div class="custom-mega-wrapper">

            <a
              href="{{ link.url }}"
              class="header__menu-item list-menu__item link"
            >
              {{ link.title }}
            </a>

            <div class="custom-mega-dropdown">

              <div class="page-width custom-mega-inner">

                <!-- LEFT SIDE MENU -->
                <div class="custom-mega-links">

                  {%- for childlink in link.links -%}

                    <div class="mega-column">

                      <a
                        href="{{ childlink.url }}"
                        class="mega-heading"
                      >
                        {{ childlink.title }}
                      </a>

                      {% if childlink.links != blank %}
                        <ul class="mega-submenu">
                          {% for grandchildlink in childlink.links %}
                            <li>
                              <a href="{{ grandchildlink.url }}">
                                {{ grandchildlink.title }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}

                    </div>

                  {%- endfor -%}

                </div>

                <!-- RIGHT SIDE PRODUCT / COLLECTION -->
                {% if mega_block != blank %}
                  <div class="custom-mega-product">

                    <div class="mega-product-heading">
                      {{ mega_block.settings.heading }}
                    </div>

                    <div class="mega-product-grid">

                      {% if mega_block.settings.collection != blank %}

  {% assign collection_handle = mega_block.settings.collection.handle %}
  {% assign mega_collection = collections[collection_handle] %}

  {% for product in mega_collection.products limit: 2 %}

    <div class="mega-product-card">

      <a href="{{ product.url }}">

        <div class="mega-product-image">
          {{
            product.featured_image
            | image_url: width: 400
            | image_tag
          }}
        </div>

        <div class="mega-product-info">
          <h4>{{ product.title }}</h4>

          <div class="price">
            {{ product.price | money }}
          </div>

        </div>

      </a>

    </div>

  {% endfor %}

                      {% elsif mega_block.settings.product_1 != blank or mega_block.settings.product_2 != blank %}

                        {% assign products_array = 
                          mega_block.settings.product_1.handle | append: ',' | append: mega_block.settings.product_2.handle | split: ',' 
                        %}

                        {% for handle in products_array %}
                          
                          {% assign product = all_products[handle] %}

                          {% if product != blank %}

                            <div class="mega-product-card">

                              <a href="{{ product.url }}">

                                <div class="mega-product-image">
                                  {{
                                    product.featured_image
                                    | image_url: width: 400
                                    | image_tag
                                  }}
                                </div>

                                <div class="mega-product-info">
                                  <h4>{{ product.title }}</h4>

                                  <div class="price">
                                    {{ product.price | money }}
                                  </div>

                                </div>

                              </a>

                            </div>

                          {% endif %}

                        {% endfor %}

                      {% endif %}

                    </div>

                  </div>
                {% endif %}

              </div>

            </div>

          </div>

        {% else %}

          <a
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link"
          >
            {{ link.title }}
          </a>

        {% endif %}
      </li>
    {%- endfor -%}
  </ul>
</nav>